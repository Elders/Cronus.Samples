<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronus" Version="11.2.5" />
    <PackageReference Include="Cronus.Api" Version="11.1.0" />
    <PackageReference Include="Cronus.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Cronus.Transport.RabbitMQ" Version="11.0.10" />
    <PackageReference Include="Cronus.Serialization.NewtonsoftJson" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
